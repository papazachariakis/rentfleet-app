generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  role         String       @default("OWNER")
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  /** Δημόσιο booking: /book/[publicToken] */
  publicToken            String?  @unique
  afm                    String?
  doy                    String?
  legalForm              String   @default("LEGAL")
  /** Βεβαίωση ΠΥΤ / τουριστική άδεια ενοικίασης */
  pytLicense             String?
  mydataUserId           String?
  mydataSubscriptionKey  String?
  mydataBranch           Int      @default(0)
  invoiceSeries          String   @default("RF")
  nextInvoiceAa          Int      @default(1)
  /** 1 = ΦΠΑ 24% (τυπικό για ενοικίαση οχημάτων) */
  vatCategory            Int      @default(1)
  taxMode                String   @default("offline")
  /** offline | sandbox | live — Ψηφιακό Πελατολόγιο */
  clientLedgerMode       String   @default("offline")
  /** AADE | ELORUS | CUSTOM — πάροχος ηλεκτρονικής τιμολόγησης */
  invoiceProvider        String   @default("AADE")
  /** Κρυπτογραφημένο API key παροχού */
  invoiceProviderApiKey  String?
  /** π.χ. Elorus Organization ID */
  invoiceProviderOrgId   String?
  /** Base URL για CUSTOM webhook / API */
  invoiceProviderBaseUrl String?
  /** Extra JSON (documentTypeId, taxId κ.λπ.) */
  invoiceProviderMeta    String?
  stripeSecretKey        String?
  stripePublishableKey   String?
  stripeWebhookSecret    String?
  stripeChargesEnabled   Boolean  @default(false)
  stripeDetailsSubmitted Boolean  @default(false)
  stripeOnboardedAt      DateTime?
  stripeAccountId        String?  @unique
  /** White-label public booking */
  brandPrimary           String?  @default("#1b6ca8")
  brandAccent            String?  @default("#0f1c2e")
  brandLogoUrl           String?
  brandTagline           String?
  brandHeroText          String?
  hidePoweredBy          Boolean  @default(false)
  createdAt              DateTime @default(now())
  memberships            Membership[]
  branches               Branch[]
  categories             VehicleCategory[]
  vehicles               Vehicle[]
  customers              Customer[]
  bookings               Booking[]
  invoices               Invoice[]
  extras                 Extra[]
  priceRules             PriceRule[]
  maintenanceLogs        MaintenanceLog[]
  channels               ChannelConnection[]
  telematicsDevices      TelematicsDevice[]
}

/** OTA / channel sync (Booking, iCal, custom) */
model ChannelConnection {
  id             String       @id @default(cuid())
  /** BOOKING | AIRBNB | EXPEDIA | ICAL | CUSTOM */
  provider       String
  name           String
  externalId     String?
  /** iCal URL για pull sync */
  icalUrl        String?
  /** Κρυπτογραφημένα API keys / tokens */
  credentials    String?
  /** ACTIVE | PAUSED | ERROR */
  status         String       @default("ACTIVE")
  lastSyncAt     DateTime?
  lastError      String?
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, provider])
}

/** Κανόνες δυναμικής τιμολόγησης ανά περίοδο / ΣΚ */
model PriceRule {
  id             String            @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  /** π.χ. 1.25 = +25% πάνω από base daily */
  multiplier     Float             @default(1.2)
  minDailyRate   Float?
  /** Αν true, εφαρμόζεται μόνο Σάββατο/Κυριακή */
  weekendOnly    Boolean           @default(false)
  active         Boolean           @default(true)
  categoryId     String?
  category       VehicleCategory?  @relation(fields: [categoryId], references: [id])
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([organizationId, startDate, endDate])
}

model Membership {
  id             String       @id @default(cuid())
  role           String       @default("ADMIN")
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Branch {
  id             String       @id @default(cuid())
  name           String
  code           String?
  address        String?
  city           String?
  phone          String?
  lat            Float?
  lng            Float?
  /** Κωδικός εγκατάστασης ΑΑΔΕ για Ψηφιακό Πελατολόγιο */
  aadeBranchCode Int          @default(0)
  active         Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  pickups        Booking[]    @relation("PickupBranch")
  returns        Booking[]    @relation("ReturnBranch")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model VehicleCategory {
  id             String       @id @default(cuid())
  name           String
  /** CAR | MOTO | SCOOTER | VAN */
  vehicleType    String       @default("CAR")
  description    String?
  baseDailyRate  Float        @default(40)
  depositAmount  Float        @default(300)
  seats          Int?
  transmission   String?
  active         Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  priceRules     PriceRule[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Vehicle {
  id               String           @id @default(cuid())
  plateNumber      String
  make             String
  model            String
  year             Int?
  color            String?
  vin              String?
  /** CAR | MOTO | SCOOTER | VAN */
  vehicleType      String           @default("CAR")
  /** AVAILABLE | RENTED | MAINTENANCE | BLOCKED | OUT_OF_SERVICE */
  status           String           @default("AVAILABLE")
  odometerKm       Int              @default(0)
  fuelType         String?
  fuelLevel        String?
  insuranceExpiry  DateTime?
  kteoExpiry       DateTime?
  /** Ετήσιος μηχανολογικός έλεγχος ενοικιαζομένων */
  mechanicalExpiry DateTime?
  /** Τελευταία γνωστή θέση (GPS / χειροκίνητα) */
  lat              Float?
  lng              Float?
  locationLabel    String?
  locationUpdatedAt DateTime?
  photos           String[]         @default([])
  notes            String?
  active           Boolean          @default(true)
  /** Αν οριστεί, υπερισχύει της τιμής κατηγορίας */
  dailyRate        Float?
  /** Αν οριστεί, υπερισχύει της εγγύησης κατηγορίας */
  depositAmount    Float?
  categoryId       String?
  category         VehicleCategory? @relation(fields: [categoryId], references: [id])
  branchId         String?
  branch           Branch?          @relation(fields: [branchId], references: [id])
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  maintenanceLogs  MaintenanceLog[]
  telematicsDevice TelematicsDevice?
  createdAt        DateTime         @default(now())

  @@unique([organizationId, plateNumber])
  @@index([organizationId, status])
}

/** ESP32 / OBD2 tracker ανά όχημα */
model TelematicsDevice {
  id              String   @id @default(cuid())
  name            String
  /** ESP32_OBD2 | ESP32_GPS | OBD2_DONGLE | OTHER */
  hardware        String   @default("ESP32_OBD2")
  /** WIFI | LTE | NR | MULTI */
  connectivity    String   @default("WIFI")
  /** sha256 του API key συσκευής */
  deviceKeyHash   String   @unique
  deviceKeyPrefix String
  imei            String?
  firmware        String?
  active          Boolean  @default(true)
  lastSeenAt      DateTime?
  /** Τελευταία τηλεμετρία (denormalized για γρήγορο UI) */
  lastLat         Float?
  lastLng         Float?
  lastSpeedKmh    Float?
  lastFuelPercent Float?
  lastOdometerKm  Float?
  lastEngineRpm   Int?
  lastCoolantC    Float?
  lastBatteryV    Float?
  lastIgnition    Boolean?
  lastDtcsJson    String?
  lastExtrasJson  String?
  lastNetwork     String?
  lastRssi        Int?
  vehicleId       String?  @unique
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  readings        TelematicsReading[]
  createdAt       DateTime @default(now())

  @@index([organizationId, active])
  @@index([lastSeenAt])
}

model TelematicsReading {
  id           String   @id @default(cuid())
  deviceId     String
  device       TelematicsDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  recordedAt   DateTime @default(now())
  lat          Float?
  lng          Float?
  speedKmh     Float?
  fuelPercent  Float?
  odometerKm   Float?
  engineRpm    Int?
  coolantC     Float?
  batteryV     Float?
  ignition     Boolean?
  dtcsJson     String?
  extrasJson   String?
  networkType  String?
  rssi         Int?
  rawJson      String?

  @@index([deviceId, recordedAt])
}

/** Service / repair / ΚΤΕΟ καταγραφές ανά όχημα */
model MaintenanceLog {
  id             String       @id @default(cuid())
  /** SERVICE | REPAIR | KTEO | INSURANCE | OTHER */
  kind           String       @default("SERVICE")
  title          String
  notes          String?
  cost           Float        @default(0)
  odometerKm     Int?
  performedAt    DateTime     @default(now())
  nextDueAt      DateTime?
  vendor         String?
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, performedAt])
  @@index([vehicleId, performedAt])
}

model Customer {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  afm            String?
  isForeign      Boolean      @default(false)
  idDocumentType String?
  idDocumentNo   String?
  licenseNumber     String?
  licenseCountry    String?
  /** Κατηγορίες διπλώματος από πίσω όψη, π.χ. "AM,A1,B" */
  licenseCategories String?
  licenseExpiry     DateTime?
  dateOfBirth    DateTime?
  address        String?
  city           String?
  country        String?      @default("GR")
  notes          String?
  blacklisted    Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@index([organizationId, lastName])
}

model Extra {
  id             String       @id @default(cuid())
  name           String
  code           String?
  description    String?
  dailyRate      Float        @default(0)
  flatRate       Float?
  active         Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingExtras  BookingExtra[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Booking {
  id                   String    @id @default(cuid())
  code                 String?   @unique
  /** DESK | ONLINE | PHONE | PARTNER */
  channel              String    @default("DESK")
  /** DRAFT | PENDING_PAYMENT | CONFIRMED | CHECKED_OUT | CHECKED_IN | CANCELLED | NO_SHOW */
  status               String    @default("CONFIRMED")
  pickupAt             DateTime
  returnAt             DateTime
  pickupPlace          String?
  returnPlace          String?
  dailyRate            Float
  days                 Int       @default(1)
  extrasTotal          Float     @default(0)
  insuranceTotal       Float     @default(0)
  discountAmount       Float     @default(0)
  subtotal             Float     @default(0)
  vatAmount            Float     @default(0)
  totalAmount          Float
  depositAmount        Float     @default(0)
  /** UNPAID | PENDING | PAID | PARTIAL | REFUNDED | FAILED */
  paymentStatus        String    @default("UNPAID")
  stripeSessionId      String?   @unique
  stripePaymentIntent  String?
  paidAt               DateTime?
  /** CDW | SCDW | TP | PAI — JSON λίστα καλύψεων */
  coveragesJson        String?
  notes                String?
  /** PDF σάρωσης διπλώματος (μπροστά+πίσω) — διαγράφεται μετά το check-in */
  licenseScanPdf       Bytes?
  licenseScanCreatedAt DateTime?
  /** Όταν στάλθηκε email επιβεβαίωσης */
  confirmationNotifiedAt DateTime?
  /** Ψηφιακό Πελατολόγιο */
  aadeLedgerId         String?
  aadeLedgerStatus     String    @default("PENDING")
  aadeDepartureAt      DateTime?
  aadeReturnAt         DateTime?
  mydataStatus         String    @default("PENDING")
  customerId           String
  customer             Customer  @relation(fields: [customerId], references: [id])
  vehicleId            String?
  vehicle              Vehicle?  @relation(fields: [vehicleId], references: [id])
  pickupBranchId       String?
  pickupBranch         Branch?   @relation("PickupBranch", fields: [pickupBranchId], references: [id])
  returnBranchId       String?
  returnBranch         Branch?   @relation("ReturnBranch", fields: [returnBranchId], references: [id])
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  extras               BookingExtra[]
  inspections          Inspection[]
  agreement            RentalAgreement?
  invoices             Invoice[]
  createdAt            DateTime  @default(now())

  @@index([organizationId, pickupAt, returnAt])
  @@index([organizationId, status])
  @@index([vehicleId, pickupAt, returnAt])
}

model BookingExtra {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraId   String
  extra     Extra   @relation(fields: [extraId], references: [id])
  quantity  Int     @default(1)
  unitPrice Float
  total     Float

  @@index([bookingId])
}

model RentalAgreement {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  termsVersion    String   @default("1.1")
  signedAt        DateTime?
  signerName      String?
  signatureData   String?
  pdfUrl          String?
  driversJson     String?
  /** Έντυπο συγκατάθεσης GDPR / προστασίας δεδομένων */
  gdprVersion     String   @default("1.0")
  gdprSignedAt    DateTime?
  gdprSignerName  String?
  createdAt       DateTime @default(now())
}

model Inspection {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /** PICKUP | RETURN */
  kind         String
  odometerKm   Int?
  fuelLevel    String?
  notes        String?
  photos       String[] @default([])
  damageNotes  String?
  inspectedAt  DateTime @default(now())
  inspectorName String?

  @@index([bookingId, kind])
}

model Invoice {
  id             String       @id @default(cuid())
  number         String
  series         String       @default("RF")
  aa             Int          @default(1)
  customerName   String
  amount         Float
  netAmount      Float        @default(0)
  vat            Float
  vatCategory    Int          @default(1)
  invoiceType    String       @default("11.2")
  mydataStatus   String       @default("DRAFT")
  mydataUid      String?
  mydataMark     String?
  qrUrl          String?
  xmlPayload     String?
  responseXml    String?
  errorMessage   String?
  issuedAt       DateTime     @default(now())
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
