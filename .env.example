DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CORS for external marketing sites (Auto Reliable etc.)
# PUBLIC_CORS_ORIGINS="https://reliable.drivemanager.gr"

# Platform admins (comma-separated) — μπορούν να μπουν σε όλους τους λογαριασμούς
PLATFORM_ADMIN_EMAILS="papazachariakis@gmail.com"

# myDATA (ΑΑΔΕ) — προαιρετικό platform fallback · οι πελάτες βάζουν δικά τους
# offline | sandbox | live
MYDATA_MODE="offline"
MYDATA_USER_ID=""
MYDATA_SUBSCRIPTION_KEY=""
MYDATA_AFM=""
MYDATA_BRANCH="0"

# Ψηφιακό Πελατολόγιο Οχημάτων
CLIENT_LEDGER_MODE="offline"

# Stripe: κάθε πελάτης βάζει τα ΔΙΚΑ του keys στο /payments (όχι εδώ).

# Email επιβεβαίωσης κρατήσεων (Resend)
